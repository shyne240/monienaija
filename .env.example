# Application
NODE_ENV=development
APP_VERSION=0.1.0
API_VERSION=v1
PORT=3000
LOG_LEVEL=debug

# Operational resilience
IDEMPOTENCY_RETENTION_SECONDS=86400
OUTBOX_RETRY_DELAY_SECONDS=60
METRICS_RETENTION_SECONDS=2592000
AUDIT_RETENTION_SECONDS=31536000
OUTBOX_RETENTION_SECONDS=2592000
BUILD_TIMESTAMP=unknown
SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30

# A5 internal pilot safety control
A5_PILOT_EMERGENCY_STOP=false

# A6 external partner boundary (references only; no secret material)
A6_PARTNER_ENABLED=false
A6_PARTNER_ENVIRONMENT=sandbox
A6_PARTNER_KEY=NIBSS_NIP
A6_PARTNER_CAPABILITY=external.wallet.withdrawal.settlement
A6_PARTNER_OPERATION_TYPE=OUTBOUND_BANK_SETTLEMENT
A6_PARTNER_API_VERSION=v1
A6_PARTNER_ADAPTER_VERSION=a6-adapter-1
A6_PARTNER_SANDBOX_BASE_URL=
A6_PARTNER_PRODUCTION_BASE_URL=
A6_PARTNER_SANDBOX_CREDENTIAL_REFERENCE=
A6_PARTNER_PRODUCTION_CREDENTIAL_REFERENCE=
A6_PARTNER_SANDBOX_SIGNING_KEY_REFERENCE=
A6_PARTNER_PRODUCTION_SIGNING_KEY_REFERENCE=
A6_PARTNER_SIGNING_ALGORITHM=HMAC_SHA256
A6_PARTNER_SANDBOX_CALLBACK_SECRET=
A6_PARTNER_PRODUCTION_CALLBACK_SECRET=
A6_PARTNER_CALLBACK_MAX_SKEW_SECONDS=300
A6_PARTNER_CIRCUIT_FAILURE_THRESHOLD=3
A6_PARTNER_CIRCUIT_OPEN_SECONDS=60
A6_PARTNER_REQUEST_TIMEOUT_MS=10000
A6_PARTNER_CONNECT_TIMEOUT_MS=3000

# A2T11 workforce and privileged authentication (provider-neutral OIDC).
# The platform integrates with any conforming OIDC provider: no provider-specific
# behaviour, endpoint or SDK is implemented.
#
# LOCAL DEVELOPMENT: Set A2_WORKFORCE_ENABLED=true to enable the workforce authentication
# flow. The backend accepts mock-sandbox-token-* tokens in development mode (NODE_ENV=development)
# for local testing without a real OIDC provider. Use "mock-sandbox-token-ADMIN" to log in
# as a FINANCE_ADMIN principal.
#
# PRODUCTION: Set A2_WORKFORCE_ENABLED=true and configure a real OIDC provider below.
# The mock token bypass is disabled when NODE_ENV=production.
#
# To disable workforce authentication entirely (not recommended for production), set
# A2_WORKFORCE_ENABLED=false. All workforce endpoints will return 401.
#
# No secret material belongs in this file - only references, identifiers and public JWKs.
A2_WORKFORCE_ENABLED=true
A2_WORKFORCE_OIDC_ISSUER=https://identity.example.com
A2_WORKFORCE_OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
A2_WORKFORCE_OIDC_AUDIENCE=workforce-admin
A2_WORKFORCE_OIDC_CLIENT_ID=admin-web
A2_WORKFORCE_INTERNAL_AUDIENCE=workforce-admin
A2_WORKFORCE_SESSION_TTL_SECONDS=900

# Break-glass bootstrap. Keep disabled outside a controlled bootstrap window.
A2_BOOTSTRAP_ENABLED=false
A2_BOOTSTRAP_ISSUER=
A2_BOOTSTRAP_AUDIENCE=
# JSON array of public RS256 JWKs ({"kid","kty":"RSA","n","e","alg":"RS256","use":"sig"}).
A2_BOOTSTRAP_JWKS_JSON=[]
# JSON array of scopes granted to the bootstrap FINANCE_ADMIN principal.
A2_BOOTSTRAP_ADMIN_SCOPES_JSON=["privileged:execute","finance:prepare","privileged:approve","finance:audit"]

# JSON array of A2 Finance role definitions.
# Role definitions must match the test expectations in test/a2-workforce-configuration.spec.ts
# FINANCE_ADMIN: Administrative operations only (role assignment/revocation), NOT operational financial actions
# FINANCE_PREPARER: Maker role for financial operations
# FINANCE_CONTROLLER: Checker/approver role for financial operations
# FINANCE_AUDITOR: Read-only audit and observability access
A2_FINANCE_ROLES_JSON=[{"roleKey":"FINANCE_ADMIN","displayName":"Finance Administrator","description":"System administrator with role management privileges","enabled":true,"scopes":["privileged:execute"],"applicableActions":["FINANCE_ROLE_ASSIGN","FINANCE_ROLE_REVOKE"],"mfaRequired":true,"approvalCapability":false,"makerEligible":true,"checkerEligible":false,"administrativeCapability":true},{"roleKey":"FINANCE_PREPARER","displayName":"Finance Preparer","description":"Prepares financial actions for approval","enabled":true,"scopes":["finance:prepare","ledger:write","deposit:create","withdrawal:create","transfer:create"],"applicableActions":["FINANCE_CONTROL_POLICY_ACTIVATE","LEDGER_JOURNAL_POST","DEPOSIT_CREATION","WITHDRAWAL_CREATION","TRANSFER_CREATION"],"mfaRequired":true,"approvalCapability":false,"makerEligible":true,"checkerEligible":false,"administrativeCapability":false},{"roleKey":"FINANCE_CONTROLLER","displayName":"Finance Controller","description":"Approves and executes financial actions","enabled":true,"scopes":["privileged:approve","privileged:execute","ledger:reverse","deposit:complete","withdrawal:complete"],"applicableActions":["FINANCE_ROLE_ASSIGN","FINANCE_ROLE_REVOKE","FINANCE_CONTROL_POLICY_ACTIVATE","LEDGER_JOURNAL_REVERSAL","DEPOSIT_COMPLETION","WITHDRAWAL_COMPLETION"],"mfaRequired":true,"approvalCapability":true,"makerEligible":false,"checkerEligible":true,"administrativeCapability":false},{"roleKey":"FINANCE_AUDITOR","displayName":"Finance Auditor","description":"Read-only audit and observability access","enabled":true,"scopes":["finance:audit","ledger:read","reconciliation:read"],"applicableActions":[],"mfaRequired":true,"approvalCapability":false,"makerEligible":false,"checkerEligible":true,"administrativeCapability":false}]

# JSON array of maker-checker rules binding actions to initiating/approving roles.
# Includes both workforce administration actions and financial operation approvals.
# Financial operations require maker/checker separation: PREPARER initiates, CONTROLLER approves and executes.
A2_MAKER_CHECKER_RULES_JSON=[{"action":"FINANCE_ROLE_ASSIGN","initiatingRoles":["FINANCE_ADMIN"],"approvingRoles":["FINANCE_CONTROLLER"],"minimumApprovals":1,"separationRequired":true,"selfApprovalProhibited":true,"mfaRequired":true,"minimumAssurance":"MFA","materialityRequired":false},{"action":"FINANCE_ROLE_REVOKE","initiatingRoles":["FINANCE_ADMIN"],"approvingRoles":["FINANCE_CONTROLLER"],"minimumApprovals":1,"separationRequired":true,"selfApprovalProhibited":true,"mfaRequired":true,"minimumAssurance":"MFA","materialityRequired":false},{"action":"FINANCE_CONTROL_POLICY_ACTIVATE","initiatingRoles":["FINANCE_PREPARER"],"approvingRoles":["FINANCE_CONTROLLER"],"minimumApprovals":1,"separationRequired":true,"selfApprovalProhibited":true,"mfaRequired":true,"minimumAssurance":"MFA","materialityRequired":false},{"action":"LEDGER_JOURNAL_POST","initiatingRoles":["FINANCE_PREPARER"],"approvingRoles":["FINANCE_CONTROLLER"],"minimumApprovals":1,"separationRequired":true,"selfApprovalProhibited":true,"mfaRequired":true,"minimumAssurance":"MFA","materialityRequired":true},{"action":"LEDGER_JOURNAL_REVERSAL","initiatingRoles":["FINANCE_CONTROLLER"],"approvingRoles":["FINANCE_CONTROLLER"],"minimumApprovals":1,"separationRequired":true,"selfApprovalProhibited":true,"mfaRequired":true,"minimumAssurance":"MFA","materialityRequired":true},{"action":"DEPOSIT_CREATION","initiatingRoles":["FINANCE_PREPARER"],"approvingRoles":["FINANCE_CONTROLLER"],"minimumApprovals":1,"separationRequired":true,"selfApprovalProhibited":true,"mfaRequired":true,"minimumAssurance":"MFA","materialityRequired":true},{"action":"DEPOSIT_COMPLETION","initiatingRoles":["FINANCE_CONTROLLER"],"approvingRoles":["FINANCE_CONTROLLER"],"minimumApprovals":1,"separationRequired":true,"selfApprovalProhibited":true,"mfaRequired":true,"minimumAssurance":"MFA","materialityRequired":true},{"action":"WITHDRAWAL_CREATION","initiatingRoles":["FINANCE_PREPARER"],"approvingRoles":["FINANCE_CONTROLLER"],"minimumApprovals":1,"separationRequired":true,"selfApprovalProhibited":true,"mfaRequired":true,"minimumAssurance":"MFA","materialityRequired":true},{"action":"WITHDRAWAL_COMPLETION","initiatingRoles":["FINANCE_CONTROLLER"],"approvingRoles":["FINANCE_CONTROLLER"],"minimumApprovals":1,"separationRequired":true,"selfApprovalProhibited":true,"mfaRequired":true,"minimumAssurance":"MFA","materialityRequired":true},{"action":"TRANSFER_CREATION","initiatingRoles":["FINANCE_PREPARER"],"approvingRoles":["FINANCE_CONTROLLER"],"minimumApprovals":1,"separationRequired":true,"selfApprovalProhibited":true,"mfaRequired":true,"minimumAssurance":"MFA","materialityRequired":true}]

# JSON array of token-bucket rate limits per security category.
A2_WORKFORCE_RATE_LIMITS_JSON=[{"category":"workforce-authentication","capacity":100,"refillRatePerSecond":10,"enabled":true},{"category":"workforce-bootstrap","capacity":10,"refillRatePerSecond":1,"enabled":true},{"category":"finance-role-administration","capacity":50,"refillRatePerSecond":5,"enabled":true},{"category":"privileged-approval","capacity":50,"refillRatePerSecond":5,"enabled":true}]
# JSON array of trusted proxy addresses or CIDR ranges used for client-address resolution.
A2_TRUSTED_PROXY_ADDRESSES_JSON=["127.0.0.1","::1/128"]

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=monienaija
DB_USER=monienaija
DB_PASSWORD=change-me-local-only
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
