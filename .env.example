# Application
NODE_ENV=development
APP_VERSION=0.1.0
API_VERSION=v1
PORT=3000
LOG_LEVEL=debug

# Operational resilience
IDEMPOTENCY_RETENTION_SECONDS=86400
OUTBOX_RETRY_DELAY_SECONDS=60
METRICS_RETENTION_SECONDS=2592000
AUDIT_RETENTION_SECONDS=31536000
OUTBOX_RETENTION_SECONDS=2592000
BUILD_TIMESTAMP=unknown
SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30

# A5 internal pilot safety control
A5_PILOT_EMERGENCY_STOP=false

# A6 external partner boundary (references only; no secret material)
A6_PARTNER_ENABLED=false
A6_PARTNER_ENVIRONMENT=sandbox
A6_PARTNER_KEY=NIBSS_NIP
A6_PARTNER_CAPABILITY=external.wallet.withdrawal.settlement
A6_PARTNER_OPERATION_TYPE=OUTBOUND_BANK_SETTLEMENT
A6_PARTNER_API_VERSION=v1
A6_PARTNER_ADAPTER_VERSION=a6-adapter-1
A6_PARTNER_SANDBOX_BASE_URL=
A6_PARTNER_PRODUCTION_BASE_URL=
A6_PARTNER_SANDBOX_CREDENTIAL_REFERENCE=
A6_PARTNER_PRODUCTION_CREDENTIAL_REFERENCE=
A6_PARTNER_SANDBOX_SIGNING_KEY_REFERENCE=
A6_PARTNER_PRODUCTION_SIGNING_KEY_REFERENCE=
A6_PARTNER_SIGNING_ALGORITHM=HMAC_SHA256
A6_PARTNER_SANDBOX_CALLBACK_SECRET=
A6_PARTNER_PRODUCTION_CALLBACK_SECRET=
A6_PARTNER_CALLBACK_MAX_SKEW_SECONDS=300
A6_PARTNER_CIRCUIT_FAILURE_THRESHOLD=3
A6_PARTNER_CIRCUIT_OPEN_SECONDS=60
A6_PARTNER_REQUEST_TIMEOUT_MS=10000
A6_PARTNER_CONNECT_TIMEOUT_MS=3000

# A2T11 workforce and privileged authentication (provider-neutral OIDC).
# The platform integrates with any conforming OIDC provider: no provider-specific
# behaviour, endpoint or SDK is implemented. Leave A2_WORKFORCE_ENABLED=false to keep
# workforce authentication fully disabled and fail-closed.
# No secret material belongs in this file - only references, identifiers and public JWKs.
A2_WORKFORCE_ENABLED=false
A2_WORKFORCE_OIDC_ISSUER=
A2_WORKFORCE_OIDC_JWKS_URI=
A2_WORKFORCE_OIDC_AUDIENCE=
A2_WORKFORCE_OIDC_CLIENT_ID=
A2_WORKFORCE_INTERNAL_AUDIENCE=workforce-admin
A2_WORKFORCE_SESSION_TTL_SECONDS=900

# Break-glass bootstrap. Keep disabled outside a controlled bootstrap window.
A2_BOOTSTRAP_ENABLED=false
A2_BOOTSTRAP_ISSUER=
A2_BOOTSTRAP_AUDIENCE=
# JSON array of public RS256 JWKs ({"kid","kty":"RSA","n","e","alg":"RS256","use":"sig"}).
A2_BOOTSTRAP_JWKS_JSON=[]
# JSON array of scopes granted to the bootstrap FINANCE_ADMIN principal.
A2_BOOTSTRAP_ADMIN_SCOPES_JSON=["privileged:execute"]

# JSON array of A2 Finance role definitions.
A2_FINANCE_ROLES_JSON=[]
# JSON array of maker-checker rules binding actions to initiating/approving roles.
A2_MAKER_CHECKER_RULES_JSON=[]
# JSON array of token-bucket rate limits per security category.
A2_WORKFORCE_RATE_LIMITS_JSON=[]
# JSON array of trusted proxy addresses or CIDR ranges used for client-address resolution.
A2_TRUSTED_PROXY_ADDRESSES_JSON=["127.0.0.1","::1/128"]

# -----------------------------------------------------------------------------------------
# V1-ADMIN-LOCAL-LOGIN-01 — OPTIONAL, LOCAL DEVELOPMENT ONLY — Admin Web real login.
# -----------------------------------------------------------------------------------------
# The real A2 workforce stack above intentionally requires a genuine external OIDC provider
# in production (A2_WORKFORCE_ENABLED=false is the safe default and MUST stay false for any
# non-development, non-test environment). To use the Admin Web (http://localhost:5173)
# "email + password" login locally without standing up a real OIDC provider, uncomment the
# block below in YOUR OWN untracked .env (never commit real values here — these are already
# public placeholders, not secrets). This activates ONLY the pre-existing, already-reviewed
# `mock-sandbox-token-*` sandbox bypass in src/authorization/workforce-oidc.service.ts, which
# is independently hard-gated to NODE_ENV=development or NODE_ENV=test and refuses outright
# under NODE_ENV=production or NODE_ENV=staging — see that file and
# src/local-admin-authentication/local-admin-authentication.service.ts for the full,
# deliberately redundant chain of guards. No new authentication architecture is introduced.
#
# After uncommenting, run: node scripts/local-dev-seed-admin.js
# Default local administrator: admin@monienaija.local / MonieNaijaAdmin123!
# (see docs/V1/V1-ADMIN-LOCAL-LOGIN-01.md for the full walkthrough)
#
# A2_WORKFORCE_ENABLED=true
# A2_WORKFORCE_OIDC_ISSUER=https://local-dev-identity.monienaija.invalid
# A2_WORKFORCE_OIDC_JWKS_URI=https://local-dev-identity.monienaija.invalid/jwks
# A2_WORKFORCE_OIDC_AUDIENCE=workforce-admin
# A2_WORKFORCE_OIDC_CLIENT_ID=workforce-admin-local-dev
# A2_FINANCE_ROLES_JSON=[{"roleKey":"FINANCE_ADMIN","displayName":"Finance Admin","description":"Local dev Finance Admin","enabled":true,"scopes":["privileged:execute"],"applicableActions":["FINANCE_ROLE_ASSIGN","FINANCE_ROLE_REVOKE"],"mfaRequired":true,"approvalCapability":false,"makerEligible":true,"checkerEligible":false,"administrativeCapability":true},{"roleKey":"FINANCE_PREPARER","displayName":"Finance Preparer","description":"Local dev Finance Preparer","enabled":true,"scopes":["finance:prepare"],"applicableActions":["FINANCE_CONTROL_POLICY_ACTIVATE"],"mfaRequired":true,"approvalCapability":false,"makerEligible":true,"checkerEligible":false,"administrativeCapability":false},{"roleKey":"FINANCE_CONTROLLER","displayName":"Finance Controller","description":"Local dev Finance Controller","enabled":true,"scopes":["privileged:approve","privileged:execute"],"applicableActions":["FINANCE_ROLE_ASSIGN","FINANCE_ROLE_REVOKE","FINANCE_CONTROL_POLICY_ACTIVATE"],"mfaRequired":true,"approvalCapability":true,"makerEligible":false,"checkerEligible":true,"administrativeCapability":false},{"roleKey":"FINANCE_AUDITOR","displayName":"Finance Auditor","description":"Local dev Finance Auditor","enabled":true,"scopes":["finance:audit"],"applicableActions":[],"mfaRequired":true,"approvalCapability":false,"makerEligible":false,"checkerEligible":false,"administrativeCapability":false}]
# A2_MAKER_CHECKER_RULES_JSON=[{"action":"FINANCE_ROLE_ASSIGN","initiatingRoles":["FINANCE_ADMIN"],"approvingRoles":["FINANCE_CONTROLLER"],"minimumApprovals":1,"separationRequired":true,"selfApprovalProhibited":true,"mfaRequired":true,"minimumAssurance":"MFA","materialityRequired":false},{"action":"FINANCE_ROLE_REVOKE","initiatingRoles":["FINANCE_ADMIN"],"approvingRoles":["FINANCE_CONTROLLER"],"minimumApprovals":1,"separationRequired":true,"selfApprovalProhibited":true,"mfaRequired":true,"minimumAssurance":"MFA","materialityRequired":false},{"action":"FINANCE_CONTROL_POLICY_ACTIVATE","initiatingRoles":["FINANCE_PREPARER"],"approvingRoles":["FINANCE_CONTROLLER"],"minimumApprovals":1,"separationRequired":true,"selfApprovalProhibited":true,"mfaRequired":true,"minimumAssurance":"MFA","materialityRequired":false}]
# A2_WORKFORCE_RATE_LIMITS_JSON=[{"category":"workforce-authentication","capacity":100,"refillRatePerSecond":50,"enabled":true},{"category":"workforce-bootstrap","capacity":100,"refillRatePerSecond":50,"enabled":true},{"category":"finance-role-administration","capacity":100,"refillRatePerSecond":50,"enabled":true},{"category":"privileged-approval","capacity":100,"refillRatePerSecond":50,"enabled":true}]

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=monienaija
DB_USER=monienaija
DB_PASSWORD=change-me-local-only
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# A15/A16/A17 agent cash-to-cash claim window.
CASH_TO_CASH_EXPIRY_SECONDS=604800

# V1-COMMERCIAL-ACCOUNTING — optional; absence keeps the commercial accounting layer inert
# (legacy evidence-only posture). All four must be set together to enable it.
COMMERCIAL_ACCOUNTING_ENABLED=false
COMMERCIAL_ACCOUNTING_VAT_TREATMENT=
COMMERCIAL_COMMISSION_ACCOUNTING_TREATMENT=
COMMERCIAL_COMMISSION_RECOGNITION_TIMING=

# SMS-V1-01 — provider-neutral SMS delivery (used for OTP and other customer notifications).
# REQUIRED FOR PRODUCTION: NODE_ENV=production fails startup unless this is explicitly set to
# "robase" with a valid ROBASE_API_KEY. The default "console" provider never delivers a real
# SMS — it only logs the message (including live OTP codes) to server stdout, and exists for
# local development only. See docs.robase.dev for obtaining a live `robe_`-prefixed API key.
NOTIFICATION_SMS_PROVIDER=console
ROBASE_API_BASE_URL=https://api.robase.dev
ROBASE_API_KEY=
ROBASE_REQUEST_TIMEOUT_MS=10000

# Background notification delivery worker (provider-neutral). Disabled by default; enable
# per environment once a real provider is configured above.
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_WORKER_POLL_INTERVAL_MS=5000
NOTIFICATION_WORKER_BATCH_SIZE=10

# Bounded SMS retry semantics (delivery level only, never reversed into finance).
SMS_RETRY_MAX_ATTEMPTS=3
SMS_RETRY_BASE_DELAY_SECONDS=60
