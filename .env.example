# Application
NODE_ENV=development
APP_VERSION=0.1.0
API_VERSION=v1
PORT=3000
LOG_LEVEL=debug

# Operational resilience
IDEMPOTENCY_RETENTION_SECONDS=86400
OUTBOX_RETRY_DELAY_SECONDS=60
METRICS_RETENTION_SECONDS=2592000
AUDIT_RETENTION_SECONDS=31536000
OUTBOX_RETENTION_SECONDS=2592000
BUILD_TIMESTAMP=unknown
SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30

# A5 internal pilot safety control
A5_PILOT_EMERGENCY_STOP=false

# A6 external partner boundary (references only; no secret material)
A6_PARTNER_ENABLED=false
A6_PARTNER_ENVIRONMENT=sandbox
A6_PARTNER_KEY=NIBSS_NIP
A6_PARTNER_CAPABILITY=external.wallet.withdrawal.settlement
A6_PARTNER_OPERATION_TYPE=OUTBOUND_BANK_SETTLEMENT
A6_PARTNER_API_VERSION=v1
A6_PARTNER_ADAPTER_VERSION=a6-adapter-1
A6_PARTNER_SANDBOX_BASE_URL=
A6_PARTNER_PRODUCTION_BASE_URL=
A6_PARTNER_SANDBOX_CREDENTIAL_REFERENCE=
A6_PARTNER_PRODUCTION_CREDENTIAL_REFERENCE=
A6_PARTNER_SANDBOX_SIGNING_KEY_REFERENCE=
A6_PARTNER_PRODUCTION_SIGNING_KEY_REFERENCE=
A6_PARTNER_SIGNING_ALGORITHM=HMAC_SHA256
A6_PARTNER_SANDBOX_CALLBACK_SECRET=
A6_PARTNER_PRODUCTION_CALLBACK_SECRET=
A6_PARTNER_CALLBACK_MAX_SKEW_SECONDS=300
A6_PARTNER_CIRCUIT_FAILURE_THRESHOLD=3
A6_PARTNER_CIRCUIT_OPEN_SECONDS=60
A6_PARTNER_REQUEST_TIMEOUT_MS=10000
A6_PARTNER_CONNECT_TIMEOUT_MS=3000

# A2T11 workforce and privileged authentication (provider-neutral OIDC).
# The platform integrates with any conforming OIDC provider: no provider-specific
# behaviour, endpoint or SDK is implemented. Leave A2_WORKFORCE_ENABLED=false to keep
# workforce authentication fully disabled and fail-closed.
# No secret material belongs in this file - only references, identifiers and public JWKs.
A2_WORKFORCE_ENABLED=false
A2_WORKFORCE_OIDC_ISSUER=
A2_WORKFORCE_OIDC_JWKS_URI=
A2_WORKFORCE_OIDC_AUDIENCE=
A2_WORKFORCE_OIDC_CLIENT_ID=
A2_WORKFORCE_INTERNAL_AUDIENCE=workforce-admin
A2_WORKFORCE_SESSION_TTL_SECONDS=900
# Retired: the workforce development mock assertion path was removed from the authentication
# services, so no environment can mint a workforce principal from a mock token. Enabling this flag
# is now rejected at startup in every environment; it is kept only so the mistake fails loudly.
# A2_WORKFORCE_DEV_MOCK_ENABLED=false

# Break-glass bootstrap. Keep disabled outside a controlled bootstrap window.
A2_BOOTSTRAP_ENABLED=false
A2_BOOTSTRAP_ISSUER=
A2_BOOTSTRAP_AUDIENCE=
# JSON array of public RS256 JWKs ({"kid","kty":"RSA","n","e","alg":"RS256","use":"sig"}).
A2_BOOTSTRAP_JWKS_JSON=[]
# JSON array of scopes granted to the bootstrap FINANCE_ADMIN principal.
A2_BOOTSTRAP_ADMIN_SCOPES_JSON=["privileged:execute"]

# JSON array of A2 Finance role definitions.
A2_FINANCE_ROLES_JSON=[]
# JSON array of maker-checker rules binding actions to initiating/approving roles.
A2_MAKER_CHECKER_RULES_JSON=[]
# JSON array of token-bucket rate limits per security category.
A2_WORKFORCE_RATE_LIMITS_JSON=[]
# JSON array of trusted proxy addresses or CIDR ranges used for client-address resolution.
A2_TRUSTED_PROXY_ADDRESSES_JSON=["127.0.0.1","::1/128"]

# HTTP surface hardening (Phase 17)
# Maximum accepted request body size in bytes (JSON payloads must keep working: >= 1 KiB).
HTTP_BODY_LIMIT_BYTES=1048576
# JSON array of exact browser origins allowed by CORS, for example
# ["https://admin.example.com","https://ops.example.com"]. Unset/empty keeps cross-origin browser
# access disabled; "*" is rejected, so production must list the real origins explicitly.
# HTTP_CORS_ORIGINS_JSON=
# Fastify trustProxy setting for client-address resolution (request.ip). Leave false when the API is
# exposed directly; set it to the number of trusted reverse-proxy hops (or "true" only when every
# hop is trusted) behind a known proxy. This is separate from A2_TRUSTED_PROXY_ADDRESSES_JSON, which
# configures the A2 workforce client-address allow-list, not the HTTP layer.
HTTP_TRUST_PROXY=false

# Customer authentication abuse controls (security parameters, not product rules).
# JSON array of token buckets for POST /customers/:id/authenticate. Both categories must always be
# present; set "enabled": false explicitly to disable one instead of removing it.
CUSTOMER_AUTH_RATE_LIMITS_JSON=[{"category":"customer-authentication","capacity":20,"refillRatePerSecond":0.5,"enabled":true},{"category":"customer-authentication-account","capacity":30,"refillRatePerSecond":0.5,"enabled":true}]

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=monienaija
DB_USER=monienaija
DB_PASSWORD=change-me-local-only
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Optional database pool and timeout overrides. Leaving these unset keeps the driver defaults; set
# them only from measured capacity/latency for the target environment (no assumed values). Unlike
# the string/JSON options above they do not accept an empty value: either omit the line or provide a
# whole number.
# DB_POOL_MAX=
# DB_POOL_IDLE_TIMEOUT_MS=
# DB_CONNECTION_TIMEOUT_MS=
# DB_STATEMENT_TIMEOUT_MS=
