/* eslint-disable @typescript-eslint/no-require-imports, @typescript-eslint/no-unsafe-assignment, @typescript-eslint/no-unsafe-member-access, @typescript-eslint/no-unsafe-call, @typescript-eslint/no-unsafe-argument */
import { ValidationPipe } from '@nestjs/common';
import { FastifyAdapter, type NestFastifyApplication } from '@nestjs/platform-fastify';
import { Test } from '@nestjs/testing';
import { randomUUID } from 'node:crypto';
import * as request from 'supertest';
import { writeFileSync, mkdirSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { createHash } from 'node:crypto';
import { LedgerEntryDirection } from '../src/ledger/ledger.enums';
import { spawnSync } from 'node:child_process';
import type { Browser, Page } from 'playwright';
import { BankingInboundService } from '../src/banking/banking-inbound.service';
import { BankingProviderRegistry, capabilitiesOf } from '../src/banking/banking-provider.registry';
import type { BankingProvider } from '../src/banking/banking-provider.types';

import { DataSource } from 'typeorm';

import { AppModule } from '../src/app.module';
import { AgentFloatFundingService } from '../src/banking/agent-float-funding.service';
import { LedgerService } from '../src/ledger/ledger.service';
import { AuditService } from '../src/operations/audit.service';
import { OutboxService } from '../src/operations/outbox.service';
import { PolicyAgentFloatFundingAuthority } from '../src/banking/agent-float-funding-authority';
import { GovernedFinancialFixture } from './support/governed-financial-fixture';
import {
  createIntegrationDataSourceFromScratch,
  destroyIntegrationDataSource,
} from './support/pg-harness';

/**
 * Agent operating float funded by a verified inbound payment.
 *
 * This is the lifecycle the banking mission could not prove: an account was provisioned, the payment
 * was verified, and then nothing credited the float. Every assertion below is about the *ledger*,
 * because a service that returned `CREDITED` without posting a balanced journal would pass a naive
 * test and move no money.
 *
 * The institution and its settlement account are created through the real authenticated console
 * (registration → evidence → governed lifecycle approval → governed ledger-account opening), so the
 * institution in these tests is genuinely APPROVED and its settlement asset is genuinely
 * institution-scoped. Nothing here forges an approval or writes a lifecycle status directly.
 *
 * The controlled fixture is a *sandbox* policy, which is what a controlled acceptance run may use.
 * Production stays withheld, and that is asserted too: it is the difference between "the lifecycle
 * works" and "this platform is authorized to fund agents with real money".
 */
describe('PR23 + PR25 real browser integration diagnostic', () => {
  let db: DataSource;
  let app: NestFastifyApplication;
  let fixture: GovernedFinancialFixture;
  let service: AgentFloatFundingService;
  let policyAuthority: PolicyAgentFloatFundingAuthority;
  let identityBrowser: Browser | undefined;

  beforeAll(async () => {
    db = await createIntegrationDataSourceFromScratch('finance25');
    const moduleRef = await Test.createTestingModule({ imports: [AppModule] })
      .overrideProvider(DataSource)
      .useValue(db)
      .compile();
    app = moduleRef.createNestApplication<NestFastifyApplication>(new FastifyAdapter());
    app.setGlobalPrefix('api/v1');
    app.useGlobalPipes(
      new ValidationPipe({ whitelist: true, transform: true, forbidNonWhitelisted: false }),
    );
    await app.init();
    await app.getHttpAdapter().getInstance().ready();

    // The application's own service instance, so the test exercises the wiring rather than a
    // hand-built copy. The runtime authority approves nothing, which is the shipped behaviour.
    service = app.get(AgentFloatFundingService);
    policyAuthority = app.get(PolicyAgentFloatFundingAuthority);
    fixture = new GovernedFinancialFixture({ app, dataSource: db, label: 'a3dfloat' });
  }, 300_000);

  afterAll(async () => {
    await identityBrowser?.close();
    await app?.close();
    /*
     * `app.close()` already tears down the TypeORM DataSource, because this suite overrides the
     * `DataSource` provider with its own instance. Calling `destroy()` unconditionally afterwards
     * throws `CannotExecuteNotConnectedError` and reddens the suite *after* every assertion has
     * passed — which is exactly how it went unnoticed. The harness's destroy path is safe in
     * either state: it handles Nest having already closed the connection, and it also removes
     * this run's isolated test database. Keep mode (drill-only) remains off in regression.
     */
    if (db) await destroyIntegrationDataSource(db);
  });

  /**
   * A fresh institution per test, created through the authenticated console.
   *
   * Nothing is truncated between tests. Truncating would delete the workforce principals and their
   * sessions that the governed fixture seeded, and re-seeding them per test would mean this suite
   * spent most of its time on console traffic. Instead each test uses its own institution, its own
   * ledger accounts and its own provider references, so the tests are independent without sharing
   * state — and the assertions are scoped to accounts that only that test created.
   */

  interface FloatFixture {
    institutionId: string;
    agentId: string;
    walletId: string;
    floatAccountId: string;
    settlementAssetId: string;
    accountNumber: string;
  }

  /**
   * An APPROVED institution with a real institution-scoped SETTLEMENT asset, an ACTIVE agent, an
   * institution-attributed AGENT wallet and an ACTIVE funding account bound to it.
   */
  async function fixtureFor(options?: {
    agentStatus?: string;
    activatePolicy?: boolean;
    environment?: 'sandbox' | 'production';
    serviceInstance?: AgentFloatFundingService;
  }): Promise<FloatFixture> {
    const institution = await fixture.createInstitution();
    const settlementAssetId = await fixture.openInstitutionSettlementAccount(institution.id);

    const suffix = randomUUID().replace(/-/g, '').slice(0, 8).toUpperCase();
    // The agent's float liability is institution-scoped: the ledger refuses a journal that mixes an
    // institution-attributed account with an unattributed one, because "the institution's cash
    // arrived" and "the institution owes this agent" are the same balance sheet.
    const floatAcct: Array<{ id: string }> = await db.query(
      `INSERT INTO ledger_accounts
         (id,code,name,account_type,normal_balance,currency,accounting_unit,
          institutional_scope,institution_id,institutional_purpose)
       VALUES ($1,$2,'Agent float liability','LIABILITY','CREDIT','NGN','CUSTOMER_FUNDS',
               'INSTITUTION',$3,'SETTLEMENT') RETURNING id`,
      [randomUUID(), `A3DF_${suffix}_FLOAT`, institution.id],
    );

    const agent: Array<{ id: string }> = await db.query(
      `INSERT INTO agents (reference,status) VALUES ($1,$2) RETURNING id`,
      [`A3DF-AG-${suffix}`, options?.agentStatus ?? 'ACTIVE'],
    );
    const agentId = agent[0]!.id;

    const wallet: Array<{ id: string }> = await db.query(
      `INSERT INTO wallet_accounts (id,customer_id,currency,status,ledger_account_id,owner_class)
       VALUES ($1,$2,'NGN','ACTIVE',$3,'AGENT') RETURNING id`,
      [randomUUID(), agentId, floatAcct[0]!.id],
    );
    const walletId = wallet[0]!.id;

    // The wallet is deliberately NOT given an institution_id here. Wallet institutional attribution
    // is immutable once written and is reachable only through the governed attribution workflow,
    // which refuses a direct write — and that refusal is a guarantee this mission preserves rather
    // than works around. The invariant this suite proves is the one the funding path actually
    // depends on: the debit leg and the policy must belong to the same institution, which the policy
    // trigger enforces against the ledger account.

    const accountNumber = `9${String(Math.floor(100000000 + Math.random() * 900000000))}`;
    await db.query(
      `INSERT INTO virtual_accounts
         (id,wallet_id,provider,bank_code,account_number,account_name,status,assigned_at,reference)
       VALUES (gen_random_uuid(),$1,'MONNIFY','50515',$2,'Agent Float Account','ACTIVE',now(),$3)`,
      [walletId, accountNumber, `MN${Date.now()}${Math.floor(Math.random() * 1000)}`],
    );

    if (options?.activatePolicy !== false) {
      await db.query(
        `INSERT INTO agent_float_funding_policies
           (id,institution_id,provider_key,environment,currency,settlement_asset_account_id,
            status,purpose,approved_by,approved_at,activated_by,activated_at)
         VALUES (gen_random_uuid(),$1,'MONNIFY',$2,'NGN',$3,
                 'ACTIVE','AGENT_OPERATING_FLOAT','fixture-approver',now(),'fixture-operator',now())`,
        [institution.id, options?.environment ?? 'sandbox', settlementAssetId],
      );
    }

    return {
      institutionId: institution.id,
      agentId,
      walletId,
      floatAccountId: floatAcct[0]!.id,
      settlementAssetId,
      accountNumber,
    };
  }

  function command(f: FloatFixture, overrides: Record<string, unknown> = {}) {
    return {
      institutionId: f.institutionId,
      agentId: f.agentId,
      walletAccountId: f.walletId,
      fundingAccountNumber: f.accountNumber,
      providerKey: 'MONNIFY',
      environment: 'sandbox' as const,
      providerReference: `MNFY-${randomUUID().slice(0, 8)}`,
      amountMinor: '250000',
      currency: 'NGN',
      correlationId: 'float-test',
      ...overrides,
    };
  }

  function policyBackedService(): AgentFloatFundingService {
    return new AgentFloatFundingService(
      db,
      app.get(LedgerService),
      app.get(AuditService),
      app.get(OutboxService),
      policyAuthority,
    );
  }
  it('records actual round-trip capability and scope/permission denials without mocking HTTP', async () => {
    const out = resolve(process.env.FINANCE25_EVIDENCE_OUT || 'data/validation/finance25-evidence');
    mkdirSync(out, { recursive: true });
    process.env.LOCAL_DEV_SEED_CONFIRM = 'disposable-local-database';
    const seed = require('../scripts/local-dev-seed-11-roles.js');
    await seed.seedLocalRoles(db, app.get('A2_WORKFORCE_CONFIG'), app.get(AuditService));
    const credentials = await db.query(
      'SELECT id,password_hash FROM local_admin_credentials ORDER BY id',
    );
    const grants = await db.query('SELECT * FROM authorization_role_functions ORDER BY id');
    const sessions: Record<string, { accessToken: string; principal: { principalId: string } }> =
      {};
    for (const role of seed.ROLES) {
      sessions[role] = (
        await request(app.getHttpServer())
          .post('/api/v1/internal/a2/workforce/local-admin-sessions')
          .send({ email: seed.emailFor(role), password: seed.passwordFor(role) })
          .expect(201)
      ).body;
    }
    const f = await fixtureFor();
    const foreign = await fixture.createInstitution();
    await fixture.grantWorkforceScope(f.institutionId, sessions.OPERATIONS!.principal.principalId);
    await fixture.grantWorkforceScope(foreign.id, sessions.FINANCE_PREPARER!.principal.principalId);
    const cmd = command(f);
    const registry = new BankingProviderRegistry();
    registry.register({
      descriptor: {
        key: 'MONNIFY',
        displayName: 'Controlled sandbox verifier',
        environment: 'sandbox',
        capabilities: capabilitiesOf({ INBOUND_PAYMENT_VERIFICATION: true }),
        descriptors: [],
      },
      verifyInboundPayment: (reference: string) =>
        Promise.resolve({
          ok: true,
          value: {
            outcome: 'VERIFIED',
            providerTransactionReference: reference,
            currency: 'NGN',
            grossAmountMinor: '250000',
            correlationId: 'finance25-test',
          },
        }),
    } as BankingProvider);
    const intake = new BankingInboundService(db, registry);
    const payment = await intake.record({
      institutionId: f.institutionId,
      providerKey: 'MONNIFY',
      environment: 'sandbox',
      providerTransactionReference: cmd.providerReference,
      receivingAccountNumber: f.accountNumber,
      currency: 'NGN',
      grossAmountMinor: '250000',
      providerFeeMinor: '0',
      creditedAmountMinor: '250000',
    });
    expect((await intake.verify(payment.id, 'finance25-test')).state).toBe('VERIFIED');
    const credited = await policyBackedService().fundFromVerifiedInbound(cmd);
    expect(credited.status).toBe('CREDITED');
    const [receipt] = await db.query(
      'SELECT journal_id FROM agent_float_funding_receipts WHERE id=$1',
      [credited.receiptId],
    );
    const destinationAccount = randomUUID();
    await db.query(
      `INSERT INTO ledger_accounts(id,code,name,account_type,normal_balance,currency,accounting_unit,institutional_scope,institution_id,institutional_purpose)
      VALUES($1,$2,'Synthetic receiving wallet','LIABILITY','CREDIT','NGN','CUSTOMER_FUNDS','INSTITUTION',$3,'SETTLEMENT')`,
      [destinationAccount, 'FIN25-' + randomUUID(), f.institutionId],
    );
    const [agent] = await db.query(
      `INSERT INTO agents(reference,status) VALUES($1,'ACTIVE') RETURNING id`,
      ['FIN25-' + randomUUID()],
    );
    const [destination] = await db.query(
      `INSERT INTO wallet_accounts(id,customer_id,currency,status,ledger_account_id,owner_class) VALUES($1,$2,'NGN','ACTIVE',$3,'AGENT') RETURNING id`,
      [randomUUID(), agent.id, destinationAccount],
    );
    const transferId = randomUUID();
    const journal = await app.get(LedgerService).postJournal({
      idempotencyKey: 'fin25-' + randomUUID(),
      currency: 'NGN',
      accountingUnit: 'CUSTOMER_FUNDS',
      description: 'Synthetic round-trip wallet transfer',
      lines: [
        { accountId: f.floatAccountId, direction: LedgerEntryDirection.DEBIT, amountMinor: '500' },
        {
          accountId: destinationAccount,
          direction: LedgerEntryDirection.CREDIT,
          amountMinor: '500',
        },
      ],
    });
    await db.query(
      `INSERT INTO transfers(id,source_wallet_id,destination_wallet_id,journal_id,amount_minor,currency,status,idempotency_key,request_hash,reference,completed_at) VALUES($1,$2,$3,$4,500,'NGN','COMPLETED',$5,$6,'FIN25-WALLET',clock_timestamp())`,
      [transferId, f.walletId, destination.id, journal.id, randomUUID(), 'a'.repeat(64)],
    );
    const records = [
      { type: 'WALLET_TRANSFER', id: transferId, journalId: journal.id, reference: 'FIN25-WALLET' },
      {
        type: 'BANK_TO_WALLET',
        id: payment.id,
        journalId: receipt.journal_id,
        reference: cmd.providerReference,
      },
    ];
    const api = (path: string, role = 'FINANCE_AUDITOR') =>
      request(app.getHttpServer())
        .get('/api/v1' + path)
        .set('Authorization', 'Bearer ' + sessions[role]!.accessToken);
    const sources: unknown[] = [];
    for (const r of records) {
      const detail = (
        await api('/internal/admin/transaction-history/' + r.type + '/' + r.id).expect(200)
      ).body;
      expect(detail.journals).toContain(r.journalId);
      expect(detail.institutionId).toBe(f.institutionId);
      expect(detail.id).toBe(r.id);
      const finance = (
        await api('/internal/finance-operations/ledger/journals/' + r.journalId).expect(200)
      ).body;
      sources.push(finance.source);
      await api('/ledger/journals/' + r.journalId).expect(200);
      await api('/ledger/journals/' + r.journalId, 'OPERATIONS').expect(403);
      await api('/internal/finance-operations/ledger/journals/' + r.journalId, 'OPERATIONS').expect(
        403,
      );
      await api('/ledger/journals/' + r.journalId, 'FINANCE_PREPARER').expect(404);
      await api(
        '/internal/finance-operations/ledger/journals/' + r.journalId,
        'FINANCE_PREPARER',
      ).expect(404);
    }
    expect(sources[0]).toMatchObject({ type: 'TRANSFER', id: transferId, linkedBy: 'JOURNAL_ID' });
    expect(sources[1]).toMatchObject({
      type: 'BANK_TO_WALLET',
      id: payment.id,
      linkedBy: 'DURABLE_INBOUND_LINK',
    });
    await app.listen(3099, '0.0.0.0');
    const binary = JSON.parse(
      spawnSync(
        process.execPath,
        [
          '-e',
          "const c=require('@sparticuz/chromium').default;c.executablePath().then(path=>console.log(JSON.stringify({path,args:c.args})))",
        ],
        { encoding: 'utf8' },
      ).stdout,
    );
    const { chromium } = require('playwright');
    identityBrowser = await chromium.launch({
      executablePath: binary.path,
      args: binary.args.filter((x: string) => x !== '--single-process'),
      headless: true,
    });
    const origin = process.env.FINANCE25_ORIGIN || 'http://127.0.0.1:5173';
    const screenshots: string[] = [];
    const shot = async (page: Page, name: string) => {
      await page.screenshot({ path: resolve(out, name + '.png'), fullPage: true });
      screenshots.push(name + '.png');
    };
    const signIn = async (role: string) => {
      const context = await identityBrowser!.newContext({ viewport: { width: 1512, height: 982 } });
      const page = await context.newPage();
      await page.goto(origin);
      await page.getByPlaceholder('Workforce email').fill(seed.emailFor(role));
      await page.getByPlaceholder('••••••••••••').fill(seed.passwordFor(role));
      await page.getByRole('button', { name: 'Sign in', exact: false }).click();
      await page
        .getByTestId(role === 'FINANCE_PREPARER' ? 'section-finance' : 'section-money')
        .waitFor();
      return page;
    };
    const auditor = await signIn('FINANCE_AUDITOR');
    for (const r of records) {
      const url = origin + '/#transaction-history/' + r.type + '/' + r.id;
      await auditor.goto(origin);
      await auditor.getByTestId('section-money').click();
      await auditor.getByTestId('nav-transfers').click();
      await auditor.getByLabel('Exact reference').fill(r.reference);
      await auditor.getByRole('button', { name: 'Apply filters', exact: true }).click();
      const historyRow = auditor
        .getByRole('row')
        .filter({ has: auditor.getByText(r.reference, { exact: true }) });
      await historyRow.getByRole('link', { name: 'View details', exact: true }).click();
      const dialog = auditor.getByRole('dialog');
      await dialog.getByRole('heading', { name: r.reference, exact: true }).waitFor();
      await dialog.getByText(r.journalId, { exact: true }).waitFor();
      await shot(auditor, r.type + '-history-open-journal');
      await dialog.getByRole('button', { name: 'Open journal', exact: true }).click();

      await auditor.getByRole('heading', { name: 'Journal Entry Details', exact: true }).waitFor();
      const back = auditor.getByTestId('open-unified-transaction-detail');
      await back.waitFor();
      expect(await back.getAttribute('href')).toBe('#transaction-history/' + r.type + '/' + r.id);
      await shot(auditor, r.type + '-journal-return-link');
      await back.click();
      await auditor
        .getByRole('dialog')
        .getByRole('heading', { name: r.reference, exact: true })
        .waitFor();
      expect(auditor.url()).toBe(url);
      await shot(auditor, r.type + '-returned-canonical-detail');
    }
    const ops = await signIn('OPERATIONS');
    for (const r of records) {
      await ops.goto(origin + '/#transaction-history/' + r.type + '/' + r.id);
      await ops
        .getByRole('dialog')
        .getByText('Ledger information requires ledger.view.', { exact: true })
        .waitFor();
      expect(await ops.getByRole('dialog').getByText(r.journalId, { exact: true }).count()).toBe(0);
      expect(
        await ops.evaluate(async (jid: string) => {
          const headers = {
            Authorization: 'Bearer ' + localStorage.getItem('admin_workforce_token'),
          };
          return await Promise.all(
            [
              '/api/v1/ledger/journals/',
              '/api/v1/internal/finance-operations/ledger/journals/',
            ].map(async (path) => (await fetch(path + jid, { headers })).status),
          );
        }, r.journalId),
      ).toEqual([403, 403]);
      expect(await ops.getByRole('button', { name: 'Open journal', exact: true }).count()).toBe(0);
      await shot(ops, r.type + '-no-ledger-permission');
    }
    // Re-scope existing OPERATIONS identity through the governed API, then fresh real UI login.
    const superToken = sessions.SUPER_ADMIN!.accessToken;
    await request(app.getHttpServer())
      .delete(
        `/api/v1/internal/institutions/${f.institutionId}/workforce/${encodeURIComponent(sessions.OPERATIONS!.principal.principalId)}`,
      )
      .set('Authorization', 'Bearer ' + superToken)
      .expect(200);
    await fixture.grantWorkforceScope(foreign.id, sessions.OPERATIONS!.principal.principalId);
    const other = await signIn('OPERATIONS');
    const foreignLedger = await signIn('FINANCE_PREPARER');
    for (const r of records) {
      await api('/internal/admin/transaction-history/' + r.type + '/' + r.id, 'OPERATIONS').expect(
        404,
      );
      await other.goto(origin + '/#transaction-history/' + r.type + '/' + r.id);
      await other.getByRole('dialog').getByRole('alert').waitFor();
      expect(await other.getByRole('heading', { name: r.reference, exact: true }).count()).toBe(0);
      await shot(other, r.type + '-foreign-detail-denied');
      await foreignLedger.goto(origin);
      await foreignLedger.getByTestId('section-finance').click();
      await foreignLedger.getByTestId('nav-ledgerExplorer').click();
      await foreignLedger.getByLabel('Audit Journal ID (UUID)').fill(r.journalId);
      await foreignLedger.getByRole('button', { name: 'Audit Journal', exact: true }).click();
      await foreignLedger
        .getByText(/not found/i)
        .first()
        .waitFor();
      expect(
        await foreignLedger.evaluate(async (jid: string) => {
          const headers = {
            Authorization: 'Bearer ' + localStorage.getItem('admin_workforce_token'),
          };
          return await Promise.all(
            [
              '/api/v1/ledger/journals/',
              '/api/v1/internal/finance-operations/ledger/journals/',
            ].map(async (path) => (await fetch(path + jid, { headers })).status),
          );
        }, r.journalId),
      ).toEqual([404, 404]);
      await shot(foreignLedger, r.type + '-foreign-journal-denied');
    }
    expect(
      await db.query('SELECT id,password_hash FROM local_admin_credentials ORDER BY id'),
    ).toEqual(credentials);
    expect(await db.query('SELECT * FROM authorization_role_functions ORDER BY id')).toEqual(
      grants,
    );
    const files = [
      'apps/admin-web/src/screens/authenticated/Layout.tsx',
      'apps/admin-web/src/screens/authenticated/TransactionHistoryScreen.tsx',
      'apps/admin-web/src/screens/authenticated/transaction-history-link.ts',
      'src/finance-operations/finance-operations.service.ts',
      'test/finance25-history-roundtrip.integration.spec.ts',
    ];
    const hashes = Object.fromEntries(
      files.map((file) => [file, createHash('sha256').update(readFileSync(file)).digest('hex')]),
    );
    writeFileSync(
      resolve(out, 'results.json'),
      JSON.stringify(
        {
          acceptance:
            'PASS: both canonical round trips and authorization checks on explicitly resolved integration tree',
          diagnosticChecks: 'PASS',
          pr23: '1b6987e8b7f1a71390f86f4ff1b71a6797097869',
          pr25: '4c007f007bbaa20596a16efdf154361aed7b1589',
          ...JSON.parse(readFileSync(resolve('integration-provenance.json'), 'utf8')),
          realWorkforceSignIn: true,
          fullyMigrated: true,
          database: (await db.query('SELECT version() AS version'))[0],
          migrations: await db.query('SELECT name FROM typeorm_migrations ORDER BY timestamp'),
          authorizationChecks: {
            ownerHistory: 200,
            auditorJournal: 200,
            operationsJournal: 403,
            foreignOperationsHistory: 404,
            foreignPreparerJournal: 404,
            journalEndpoints: [
              'ledger/journals/:id',
              'internal/finance-operations/ledger/journals/:id',
            ],
            browserDirectJournalRequests: true,
          },
          records,
          sources,
          screenshots,
          hashes,
          blockers: [],
          passwords: 'all 11 authenticated; hashes and role/function grants unchanged',
          executedAt: new Date().toISOString(),
        },
        null,
        2,
      ),
    );
  }, 180000);
});
