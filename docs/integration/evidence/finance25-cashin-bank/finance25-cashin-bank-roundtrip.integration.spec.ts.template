/* eslint-disable @typescript-eslint/no-require-imports, @typescript-eslint/no-unsafe-assignment, @typescript-eslint/no-unsafe-member-access, @typescript-eslint/no-unsafe-call, @typescript-eslint/no-unsafe-argument */
import { ValidationPipe } from '@nestjs/common';
import { FastifyAdapter, type NestFastifyApplication } from '@nestjs/platform-fastify';
import { Test } from '@nestjs/testing';
import { createHash, randomUUID } from 'node:crypto';
import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { resolve } from 'node:path';
import * as request from 'supertest';
import { DataSource } from 'typeorm';
import type { Browser, Page } from 'playwright';

import { AppModule } from '../src/app.module';
import { AgentFloatFundingService } from '../src/banking/agent-float-funding.service';
import { BankingInboundService } from '../src/banking/banking-inbound.service';
import { BankingProviderRegistry, capabilitiesOf } from '../src/banking/banking-provider.registry';
import type { BankingProvider } from '../src/banking/banking-provider.types';
import { PolicyAgentFloatFundingAuthority } from '../src/banking/agent-float-funding-authority';
import { LedgerService } from '../src/ledger/ledger.service';
import { LedgerEntryDirection } from '../src/ledger/ledger.enums';
import { AuditService } from '../src/operations/audit.service';
import { OutboxService } from '../src/operations/outbox.service';
import { GovernedFinancialFixture } from './support/governed-financial-fixture';
import {
  createIntegrationDataSourceFromScratch,
  destroyIntegrationDataSource,
} from './support/pg-harness';

/**
 * Real-session combined acceptance for the two posted products Finance #25 must return to:
 * Cash to Wallet (CASH_IN) and Bank to Wallet (BANK_TO_WALLET).
 *
 * Everything server-side is real: a fully migrated disposable PostgreSQL, the actual AppModule,
 * actual Finance and Transaction History controllers, real workforce credential/session endpoints
 * and real Chromium sign-in. Only the external provider verifier and sandbox float policy are the
 * controlled boundaries the funding fixture already uses. Nothing is mocked at the browser network
 * layer.
 *
 * The PR23 forward half (History drawer -> journal) is still missing in this PR23 head, so this
 * suite records that as a blocker instead of pretending the journal UUID text is a link. It proves
 * the Finance half: the posted journal is reachable in the Finance ledger and its return link
 * resolves to the same canonical business record.
 */
describe('PR23 + PR25 real-session Cash to Wallet and Bank to Wallet round trip', () => {
  let db: DataSource;
  let app: NestFastifyApplication;
  let fixture: GovernedFinancialFixture;
  let browser: Browser | undefined;

  beforeAll(async () => {
    db = await createIntegrationDataSourceFromScratch('f25cw');
    const moduleRef = await Test.createTestingModule({ imports: [AppModule] })
      .overrideProvider(DataSource)
      .useValue(db)
      .compile();
    app = moduleRef.createNestApplication<NestFastifyApplication>(new FastifyAdapter());
    app.setGlobalPrefix('api/v1');
    app.useGlobalPipes(
      new ValidationPipe({ whitelist: true, transform: true, forbidNonWhitelisted: false }),
    );
    await app.init();
    await app.getHttpAdapter().getInstance().ready();
    fixture = new GovernedFinancialFixture({ app, dataSource: db, label: 'f25cw' });
  }, 300_000);

  afterAll(async () => {
    await browser?.close();
    await app?.close();
    if (db) await destroyIntegrationDataSource(db);
  });

  interface FloatFixture {
    institutionId: string;
    agentId: string;
    walletId: string;
    floatAccountId: string;
    settlementAssetId: string;
    accountNumber: string;
  }

  async function fixtureFor(): Promise<FloatFixture> {
    const institution = await fixture.createInstitution();
    const settlementAssetId = await fixture.openInstitutionSettlementAccount(institution.id);
    const suffix = randomUUID().replace(/-/g, '').slice(0, 8).toUpperCase();
    const floatAcct: Array<{ id: string }> = await db.query(
      `INSERT INTO ledger_accounts
         (id,code,name,account_type,normal_balance,currency,accounting_unit,
          institutional_scope,institution_id,institutional_purpose)
       VALUES ($1,$2,'Agent float liability','LIABILITY','CREDIT','NGN','CUSTOMER_FUNDS',
               'INSTITUTION',$3,'SETTLEMENT') RETURNING id`,
      [randomUUID(), `F25CW_${suffix}_FLOAT`, institution.id],
    );
    const agent: Array<{ id: string }> = await db.query(
      `INSERT INTO agents (reference,status) VALUES ($1,'ACTIVE') RETURNING id`,
      [`F25CW-AG-${suffix}`],
    );
    const wallet: Array<{ id: string }> = await db.query(
      `INSERT INTO wallet_accounts (id,customer_id,currency,status,ledger_account_id,owner_class)
       VALUES ($1,$2,'NGN','ACTIVE',$3,'AGENT') RETURNING id`,
      [randomUUID(), agent[0]!.id, floatAcct[0]!.id],
    );
    const accountNumber = `9${String(Math.floor(100000000 + Math.random() * 900000000))}`;
    await db.query(
      `INSERT INTO virtual_accounts
         (id,wallet_id,provider,bank_code,account_number,account_name,status,assigned_at,reference)
       VALUES (gen_random_uuid(),$1,'MONNIFY','50515',$2,'Agent Float Account','ACTIVE',now(),$3)`,
      [wallet[0]!.id, accountNumber, `MN${Date.now()}${Math.floor(Math.random() * 1000)}`],
    );
    await db.query(
      `INSERT INTO agent_float_funding_policies
         (id,institution_id,provider_key,environment,currency,settlement_asset_account_id,
          status,purpose,approved_by,approved_at,activated_by,activated_at)
       VALUES (gen_random_uuid(),$1,'MONNIFY','sandbox','NGN',$2,
               'ACTIVE','AGENT_OPERATING_FLOAT','fixture-approver',now(),'fixture-operator',now())`,
      [institution.id, settlementAssetId],
    );
    return {
      institutionId: institution.id,
      agentId: agent[0]!.id,
      walletId: wallet[0]!.id,
      floatAccountId: floatAcct[0]!.id,
      settlementAssetId,
      accountNumber,
    };
  }

  function policyBackedService(): AgentFloatFundingService {
    return new AgentFloatFundingService(
      db,
      app.get(LedgerService),
      app.get(AuditService),
      app.get(OutboxService),
      app.get(PolicyAgentFloatFundingAuthority),
    );
  }

  it('returns each posted journal to the same canonical Cash to Wallet and Bank to Wallet detail', async () => {
    const out = resolve(process.env.FINANCE25_EVIDENCE_OUT || 'data/validation/finance25-cashin-bank');
    mkdirSync(out, { recursive: true });
    process.env.LOCAL_DEV_SEED_CONFIRM = 'disposable-local-database';
    const seed = require('../scripts/local-dev-seed-11-roles.js');
    await seed.seedLocalRoles(db, app.get('A2_WORKFORCE_CONFIG'), app.get(AuditService));
    const credentials = await db.query('SELECT id,password_hash FROM local_admin_credentials ORDER BY id');
    const grants = await db.query('SELECT * FROM authorization_role_functions ORDER BY id');
    const sessions: Record<string, { accessToken: string; principal: { principalId: string } }> = {};
    for (const role of seed.ROLES) {
      sessions[role] = (
        await request(app.getHttpServer())
          .post('/api/v1/internal/a2/workforce/local-admin-sessions')
          .send({ email: seed.emailFor(role), password: seed.passwordFor(role) })
          .expect(201)
      ).body;
    }

    const f = await fixtureFor();
    const cmd = {
      institutionId: f.institutionId,
      agentId: f.agentId,
      walletAccountId: f.walletId,
      fundingAccountNumber: f.accountNumber,
      providerKey: 'MONNIFY',
      environment: 'sandbox' as const,
      providerReference: `MNFY-${randomUUID().slice(0, 8)}`,
      amountMinor: '250000',
      currency: 'NGN',
      correlationId: 'f25cw-float',
    };
    const registry = new BankingProviderRegistry();
    registry.register({
      descriptor: {
        key: 'MONNIFY',
        displayName: 'Controlled sandbox verifier',
        environment: 'sandbox',
        capabilities: capabilitiesOf({ INBOUND_PAYMENT_VERIFICATION: true }),
        descriptors: [],
      },
      verifyInboundPayment: (reference: string) =>
        Promise.resolve({
          ok: true,
          value: {
            outcome: 'VERIFIED',
            providerTransactionReference: reference,
            currency: 'NGN',
            grossAmountMinor: '250000',
            correlationId: 'f25cw-intake',
          },
        }),
    } as BankingProvider);
    const intake = new BankingInboundService(db, registry);
    const payment = await intake.record({
      institutionId: f.institutionId,
      providerKey: 'MONNIFY',
      environment: 'sandbox',
      providerTransactionReference: cmd.providerReference,
      receivingAccountNumber: f.accountNumber,
      currency: 'NGN',
      grossAmountMinor: '250000',
      providerFeeMinor: '0',
      creditedAmountMinor: '250000',
    });
    expect((await intake.verify(payment.id, 'f25cw-intake')).state).toBe('VERIFIED');
    const credited = await policyBackedService().fundFromVerifiedInbound(cmd);
    expect(credited.status).toBe('CREDITED');
    const [receipt] = await db.query(
      'SELECT journal_id FROM agent_float_funding_receipts WHERE id=$1',
      [credited.receiptId],
    );
    const [link] = await db.query(
      'SELECT payment_id, float_receipt_id FROM banking_inbound_float_links WHERE payment_id=$1',
      [payment.id],
    );
    expect(link).toMatchObject({ payment_id: payment.id, float_receipt_id: credited.receiptId });

    // Cash to Wallet: the original canonical-service journal, plus a completed deposit row that
    // lets the generic Finance source union resolve the same journal (the contract keys CASH_IN by
    // this journal id, never by the deposit row id).
    const cashJournal = await app.get(LedgerService).postJournal({
      idempotencyKey: 'f25cw-cashin-' + randomUUID(),
      currency: 'NGN',
      accountingUnit: 'CUSTOMER_FUNDS',
      reference: 'F25CW-CASHIN',
      description: 'Cash to Wallet synthetic posting',
      metadata: { canonicalService: 'CASH_IN', amountMinor: '250000', customerId: randomUUID() },
      lines: [
        { accountId: f.settlementAssetId, direction: LedgerEntryDirection.DEBIT, amountMinor: '250000' },
        { accountId: f.floatAccountId, direction: LedgerEntryDirection.CREDIT, amountMinor: '250000' },
      ],
    });
    const cashInId = randomUUID();
    await db.query(
      `INSERT INTO deposits
         (id,wallet_id,journal_id,payment_reference,amount_minor,currency,status,
          idempotency_key,request_hash,reference,completed_at)
       VALUES ($1,$2,$3,$4,250000,'NGN','COMPLETED',$5,$6,'F25CW-CASHIN',now())`,
      [cashInId, f.walletId, cashJournal.id, `CASHIN-${cashInId}`, `cashin-${cashInId}`, 'b'.repeat(64)],
    );

    const records = [
      {
        type: 'CASH_IN',
        id: cashJournal.id,
        businessId: cashJournal.id,
        journalId: cashJournal.id,
        reference: 'F25CW-CASHIN',
        sourceType: 'DEPOSIT',
      },
      {
        type: 'BANK_TO_WALLET',
        id: payment.id,
        businessId: payment.id,
        journalId: receipt.journal_id,
        reference: cmd.providerReference,
        sourceType: 'BANK_TO_WALLET',
      },
    ];

    const api = (path: string, role = 'FINANCE_AUDITOR') =>
      request(app.getHttpServer())
        .get('/api/v1' + path)
        .set('Authorization', 'Bearer ' + sessions[role]!.accessToken);

    // Server-side proof first: canonical detail and Finance source resolution.
    for (const r of records) {
      const detail = (await api('/internal/admin/transaction-history/' + r.type + '/' + r.id).expect(200)).body;
      expect(detail.journals).toContain(r.journalId);
      const finance = (await api('/internal/finance-operations/ledger/journals/' + r.journalId).expect(200)).body;
      expect(finance.source).toMatchObject({ type: r.sourceType });
      if (r.type === 'BANK_TO_WALLET') {
        expect(finance.source).toMatchObject({ id: payment.id, linkedBy: 'DURABLE_INBOUND_LINK' });
        expect(finance.source.id).not.toBe(credited.receiptId);
      }
    }

    await app.listen(3099, '0.0.0.0');
    const { chromium } = require('playwright');
    browser = await chromium.launch({
      executablePath: process.env.CHROMIUM_EXECUTABLE || '/tmp/chromium',
      args: ['--no-sandbox'],
      headless: true,
    });
    const origin = process.env.FINANCE25_ORIGIN || 'http://127.0.0.1:5173';
    const screenshots: string[] = [];
    const shot = async (page: Page, name: string) => {
      await page.screenshot({ path: resolve(out, name + '.png'), fullPage: true });
      screenshots.push(name + '.png');
    };
    const signIn = async (role: string) => {
      const context = await browser!.newContext({ viewport: { width: 1512, height: 982 } });
      const page = await context.newPage();
      await page.goto(origin);
      await page.locator('#admin-login-email').fill(seed.emailFor(role));
      await page.locator('#admin-login-password').fill(seed.passwordFor(role));
      await page.getByRole('button', { name: 'Sign in', exact: false }).click();
      try {
        await page.getByTestId('desktop-nav').waitFor({ timeout: 30_000 });
        if (role.startsWith('FINANCE_')) {
          if (!(await page.getByTestId('section-finance').isVisible()))
            await page.getByTestId('section-home').click();
          await page.getByTestId('section-finance').waitFor({ timeout: 30_000 });
        }
      } catch (error) {
        const alert = await page.locator('[role="alert"]').allInnerTexts().catch(() => []);
        // eslint-disable-next-line no-console
        console.error('SIGN-IN FAILED', role, page.url(), alert, (await page.locator('body').innerText()).slice(0, 800));
        await page.screenshot({ path: resolve(out, 'signin-failed-' + role + '.png') });
        throw error;
      }
      return page;
    };

    const auditor = await signIn('FINANCE_AUDITOR');
    const browserResults: Array<Record<string, unknown>> = [];
    for (const r of records) {
      const expectedHash = '#transaction-history/' + r.type + '/' + r.businessId;
      // 1. History detail for this product.
      await auditor.goto(origin + '/#transaction-history/' + r.type + '/' + r.id);
      const dialog = auditor.getByRole('dialog');
      await dialog.getByRole('heading', { name: r.reference, exact: true }).waitFor({ timeout: 30_000 });
      await dialog.getByText(r.journalId, { exact: true }).first().waitFor({ timeout: 30_000 });
      const historyLinks = await dialog.getByRole('link').count();
      await shot(auditor, r.type + '-history-detail');
      // 2. Finance ledger: open the posted journal and read its return link.
      await auditor.goto(origin);
      await auditor.getByTestId('section-finance').click();
      await auditor.getByTestId('nav-ledgerExplorer').click();
      await auditor.getByTestId('ledger-record-reference').fill(r.journalId);
      await auditor.getByTestId('ledger-record-search-submit').click();
      const row = auditor.getByTestId('ledger-record-open-' + r.journalId);
      await row.waitFor({ timeout: 30_000 });
      await row.click();
      await auditor.getByTestId('reversal-eligibility').waitFor({ timeout: 30_000 });
      const back = auditor.getByTestId('open-unified-transaction-detail');
      await back.waitFor({ timeout: 30_000 });
      const href = await back.getAttribute('href');
      await shot(auditor, r.type + '-finance-journal-return-link');
      expect(href).toBe(expectedHash);
      await back.click();
      const returned = auditor.getByRole('dialog');
      await returned.getByRole('heading', { name: r.reference, exact: true }).waitFor({ timeout: 30_000 });
      expect(auditor.url()).toBe(origin + '/#transaction-history/' + r.type + '/' + r.businessId);
      await shot(auditor, r.type + '-returned-canonical-detail');
      browserResults.push({
        type: r.type,
        businessId: r.businessId,
        journalId: r.journalId,
        historyDetailReference: r.reference,
        historyJournalLinkCount: historyLinks,
        financeSource: r.sourceType,
        returnHref: href,
        returnedUrl: auditor.url(),
        returnedReference: r.reference,
      });
    }

    // Authorization is unchanged: OPERATIONS sees the record without ledger content and cannot GET
    // either journal endpoint with the real UI-issued token.
    await fixture.grantWorkforceScope(f.institutionId, sessions.OPERATIONS!.principal.principalId);
    const ops = await signIn('OPERATIONS');
    const denial: Record<string, unknown> = {};
    for (const r of records) {
      await ops.goto(origin + '/#transaction-history/' + r.type + '/' + r.id);
      await ops
        .getByRole('dialog')
        .getByText('Ledger information requires ledger.view.', { exact: true })
        .waitFor({ timeout: 30_000 });
      // The server withholds ledger IDs entirely without ledger.view; the drawer says so.
      const opsDetail = (
        await api('/internal/admin/transaction-history/' + r.type + '/' + r.id, 'OPERATIONS').expect(200)
      ).body;
      expect(opsDetail.journals).toBeNull();
      const statuses = await ops.evaluate(async (jid: string) => {
        const headers = { Authorization: 'Bearer ' + localStorage.getItem('admin_workforce_token') };
        return await Promise.all(
          ['/api/v1/ledger/journals/', '/api/v1/internal/finance-operations/ledger/journals/'].map(
            async (path) => (await fetch(path + jid, { headers })).status,
          ),
        );
      }, r.journalId);
      expect(statuses).toEqual([403, 403]);
      denial[r.type] = statuses;
      await shot(ops, r.type + '-operations-denied-journal');
    }

    expect(await db.query('SELECT id,password_hash FROM local_admin_credentials ORDER BY id')).toEqual(
      credentials,
    );
    expect(await db.query('SELECT * FROM authorization_role_functions ORDER BY id')).toEqual(grants);

    const files = [
      'apps/admin-web/src/screens/authenticated/Layout.tsx',
      'apps/admin-web/src/screens/authenticated/TransactionHistoryScreen.tsx',
      'apps/admin-web/src/screens/authenticated/transaction-history-link.ts',
      'src/finance-operations/finance-operations.service.ts',
      'test/finance25-cashin-bank-roundtrip.integration.spec.ts',
    ];
    const hashes = Object.fromEntries(
      files.map((file) => [file, createHash('sha256').update(readFileSync(file)).digest('hex')]),
    );
    writeFileSync(
      resolve(out, 'results.json'),
      JSON.stringify(
        {
          acceptance: 'FINANCE_RETURN_HALF_PASS_FORWARD_HALF_BLOCKED_BY_PR23',
          pr23: '3c7f5c98fee27cb7164ee27f75605aeb58226c51',
          pr25: '8301fa2',
          combinedMergeCommit: '6036c17',
          resolution:
            'Layout.tsx conflict resolved by taking PR23 content (PR23 owns integration); no other product patch',
          realWorkforceSignIn: true,
          fullyMigrated: true,
          noBrowserApiStubs: true,
          database: (await db.query('SELECT version() AS version'))[0],
          migrationCount: (await db.query('SELECT count(*)::int AS n FROM typeorm_migrations'))[0].n,
          records,
          bankToWalletEvidence: {
            paymentId: payment.id,
            floatReceiptId: credited.receiptId,
            receiptJournalId: receipt.journal_id,
            durableLink: link,
          },
          browserResults,
          authorizationDenials: denial,
          forwardHalf: 'BLOCKED: PR23 TransactionHistoryScreen renders the journal UUID as <code>; no guarded journal navigation exists in 3c7f5c9',
          screenshots,
          hashes,
          executedAt: new Date().toISOString(),
        },
        null,
        2,
      ),
    );
  }, 240_000);
});
