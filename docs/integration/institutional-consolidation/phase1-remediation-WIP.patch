+  @MinLength(1)
+  @MaxLength(160)
+  evidenceReference!: string;
+
+  @IsString()
+  @Transform(({ value }) => trim(value))
+  @MinLength(10)
+  @MaxLength(500)
+  reason!: string;
+
+  @IsOptional()
+  @Type(() => Number)
+  @IsInt()
+  @Min(60)
+  @Max(86400)
+  expiresInSeconds?: number;
+}
+
+export class ExecuteInstitutionAffiliationDto extends RequestInstitutionAffiliationDto {
+  @IsUUID()
+  @Transform(({ value }) => trim(value))
