# ============================================================================
# MonieNaija V1 — Workforce (A2) authentication + one-time bootstrap template
# ============================================================================
# Companion document: docs/V1-WORKFORCE-BOOTSTRAP-RUNBOOK-01.md (follow it exactly).
#
# RULES:
#  - Every variable below EXISTS in src/config/environment.ts and
#    src/authorization/workforce-configuration.ts — nothing here is invented.
#  - This file contains ONLY references, identifiers, policy JSON and PUBLIC keys.
#    A private key NEVER belongs in any env file: the bootstrap private key lives
#    only in the operator's offline ceremony environment.
#  - The policy JSON examples below are a *valid starting set* derived from the
#    repository's own verified configuration fixtures. Tailor scopes/actions to the
#    approved access review; keep the structural invariants noted inline.
#  - Sections marked PRODUCTION-REQUIRED must be set for a real deployment.
#  - Sections marked BOOTSTRAP WINDOW are enabled only for the one-time ceremony.
#  - Sections marked OPTIONAL may be omitted (defaults are shown).
#  - Section DEV/TEST explains non-production behavior; it is never configured in prod.
# ============================================================================

# ---------------------------------------------------------------------------
# CORE (PRODUCTION-REQUIRED)
# ---------------------------------------------------------------------------
# NODE_ENV binds BOTH the OIDC trust and the bootstrap: bootstrap statements and
# bootstrap JWKs carry an environment field that must equal this value.
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# WORKFORCE AUTHENTICATION (PRODUCTION-REQUIRED when workforce plane is used)
# ---------------------------------------------------------------------------
# Master switch. When false the entire workforce plane is disabled and fails closed.
A2_WORKFORCE_ENABLED=true

# OIDC provider integration (provider-neutral). In production BOTH URLs MUST be HTTPS
# (the configuration validator enforces this and startup fails otherwise).
# Obtain from your IdP (e.g. Entra ID / Keycloak / Okta discovery document).
A2_WORKFORCE_OIDC_ISSUER=https://idp.example.com
A2_WORKFORCE_OIDC_JWKS_URI=https://idp.example.com/.well-known/jwks.json

# The API audience this deployment expects in workforce idTokens, and the IdP-registered
# client id of the workforce console (required for azp validation on multi-audience tokens).
A2_WORKFORCE_OIDC_AUDIENCE=monienaija-workforce
A2_WORKFORCE_OIDC_CLIENT_ID=monienaija-admin-console

# REQUIRED when A2_WORKFORCE_ENABLED=true. Audience of the internal session tokens
# (they are validated against this on every /internal/** request).
A2_WORKFORCE_INTERNAL_AUDIENCE=workforce-admin

# OPTIONAL (default 900, bounds 60..3600). Internal workforce session lifetime, seconds.
A2_WORKFORCE_SESSION_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# ONE-TIME BOOTSTRAP (BOOTSTRAP WINDOW ONLY — enable for the ceremony, disable after)
# ---------------------------------------------------------------------------
# Keep false except during the controlled bootstrap window (runbook §5).
A2_BOOTSTRAP_ENABLED=false

# REQUIRED during the window: identifies this bootstrap ceremony.
A2_BOOTSTRAP_ISSUER=monienaija-v1-bootstrap-operator
# Must equal the --audience you pass to scripts/generate-bootstrap-statement.ts.
A2_BOOTSTRAP_AUDIENCE=monienaija-v1-bootstrap

# Trust for the statement-signing key. PRODUCTION-REQUIRED during the window.
# REPLACE the empty array with the envSnippet.A2_BOOTSTRAP_JWKS_JSON printed by the
# generator (it contains the PUBLIC key only). The JWK 'environment' field must equal
# NODE_ENV above. Example shape (single line):
#   A2_BOOTSTRAP_JWKS_JSON=[{"kid":"<kid>","kty":"RSA","n":"...","e":"AQAB","alg":"RS256","use":"sig","environment":"production"}]
A2_BOOTSTRAP_JWKS_JSON=[]

# Scopes granted to the bootstrap FINANCE_ADMIN. STRUCTURAL INVARIANT: this array must
# EXACTLY equal the scopes of the FINANCE_ADMIN role in A2_FINANCE_ROLES_JSON below
# (the validator compares sorted sets and refuses startup on any difference).
A2_BOOTSTRAP_ADMIN_SCOPES_JSON=["privileged:execute"]

# ---------------------------------------------------------------------------
# FINANCE ROLE + MAKER/CHECKER POLICY (PRODUCTION-REQUIRED when enabled)
# ---------------------------------------------------------------------------
# STRUCTURAL INVARIANTS enforced at startup (fail-closed):
#  - exactly these four roles, no more, no fewer;
#  - administrativeCapability=true is reserved for FINANCE_ADMIN;
#  - approvalCapability=true  => mfaRequired=true and checkerEligible=true;
#  - roles referenced in maker/checker rules must exist, be enabled, and list the
#    governed action in applicableActions; initiating roles must be makerEligible
#    (or administrative); approving roles must be approval-capable + checker-eligible.
A2_FINANCE_ROLES_JSON=[{"roleKey":"FINANCE_ADMIN","displayName":"Finance Administrator","description":"Initial privileged finance administration; bootstrap-only granting.","enabled":true,"scopes":["privileged:execute"],"applicableActions":["FINANCE_ROLE_ASSIGN","FINANCE_ROLE_REVOKE"],"mfaRequired":true,"approvalCapability":false,"makerEligible":true,"checkerEligible":false,"administrativeCapability":true},{"roleKey":"FINANCE_PREPARER","displayName":"Finance Preparer","description":"Initiates finance control changes for approval.","enabled":true,"scopes":["finance:prepare"],"applicableActions":["FINANCE_CONTROL_POLICY_ACTIVATE"],"mfaRequired":true,"approvalCapability":false,"makerEligible":true,"checkerEligible":false,"administrativeCapability":false},{"roleKey":"FINANCE_CONTROLLER","displayName":"Finance Controller","description":"Approves finance role and control-policy changes.","enabled":true,"scopes":["privileged:approve","privileged:execute"],"applicableActions":["FINANCE_ROLE_ASSIGN","FINANCE_ROLE_REVOKE","FINANCE_CONTROL_POLICY_ACTIVATE"],"mfaRequired":true,"approvalCapability":true,"makerEligible":false,"checkerEligible":true,"administrativeCapability":false},{"roleKey":"FINANCE_AUDITOR","displayName":"Finance Auditor","description":"Read-oriented assurance role.","enabled":true,"scopes":["finance:audit"],"applicableActions":[],"mfaRequired":true,"approvalCapability":false,"makerEligible":false,"checkerEligible":false,"administrativeCapability":false}]
# The three REQUIRED action rules (validator refuses startup if any is missing).
A2_MAKER_CHECKER_RULES_JSON=[{"action":"FINANCE_ROLE_ASSIGN","initiatingRoles":["FINANCE_ADMIN"],"approvingRoles":["FINANCE_CONTROLLER"],"minimumApprovals":1,"separationRequired":true,"selfApprovalProhibited":true,"mfaRequired":true,"minimumAssurance":"MFA","materialityRequired":false},{"action":"FINANCE_ROLE_REVOKE","initiatingRoles":["FINANCE_ADMIN"],"approvingRoles":["FINANCE_CONTROLLER"],"minimumApprovals":1,"separationRequired":true,"selfApprovalProhibited":true,"mfaRequired":true,"minimumAssurance":"MFA","materialityRequired":false},{"action":"FINANCE_CONTROL_POLICY_ACTIVATE","initiatingRoles":["FINANCE_PREPARER"],"approvingRoles":["FINANCE_CONTROLLER"],"minimumApprovals":1,"separationRequired":true,"selfApprovalProhibited":true,"mfaRequired":true,"minimumAssurance":"MFA","materialityRequired":false}]

# REQUIRED when enabled — token-bucket rate limits; ALL FOUR categories must be present
# and enabled (validator refuses startup otherwise).
A2_WORKFORCE_RATE_LIMITS_JSON=[{"category":"workforce-authentication","capacity":100,"refillRatePerSecond":50,"enabled":true},{"category":"workforce-bootstrap","capacity":100,"refillRatePerSecond":50,"enabled":true},{"category":"finance-role-administration","capacity":100,"refillRatePerSecond":50,"enabled":true},{"category":"privileged-approval","capacity":100,"refillRatePerSecond":50,"enabled":true}]

# OPTIONAL (default shown). Client-IP trust for rate limiting behind a proxy.
A2_TRUSTED_PROXY_ADDRESSES_JSON=["127.0.0.1","::1/128"]

# ---------------------------------------------------------------------------
# DEV/TEST ONLY — never set in production. For awareness only; NOTHING TO CONFIGURE.
# ---------------------------------------------------------------------------
# With NODE_ENV != production the OIDC validator additionally accepts synthetic
# "mock-sandbox-token-*" assertions and grants the mock subject all enabled roles —
# a deliberate local-acceptance bypass. It is dead code in production builds
# (hard NODE_ENV gate; the production Docker image pins NODE_ENV=production).
# There is NO environment variable that enables/disables this bypass.
