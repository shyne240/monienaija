# Portable Infrastructure Acceptance — synthetic disposable configuration
#
# PURPOSE
#   Synthetic, non-production configuration for the portable acceptance harness.
#   Every value is obviously fake and will be refused by the production readiness
#   gate (the eight financial blockers). It is safe to print in logs.
#
# USAGE
#   cp infra/portable-acceptance/.env.acceptance.example .env.acceptance
#   # Optionally edit HTTP_PORT/HTTPS_PORT if host ports conflict.
#   # Then run:
#   PORTABLE_ACCEPT_DISPOSABLE=yes ./scripts/portable-acceptance/run-all.sh
#
# SAFETY
#   The harness itself refuses to execute unless PORTABLE_ACCEPT_DISPOSABLE=yes and
#   the project name contains "portable-acceptance" or the caller passes
#   --disposable. This prevents accidental execution against a shared database.
#   Never source this file into a production shell — it contains placeholder
#   secrets that would weaken a real deployment if reused.
#

# --- Identity ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=monienaija-portable-acceptance
NODE_ENV=development
APP_VERSION=0.1.0-portable-acceptance
API_VERSION=v1
PORT=3000
LOG_LEVEL=info
BUILD_TIMESTAMP=portable-acceptance

# --- Project / ports --------------------------------------------------------
DB_NAME=monienaija_portable
DB_ADMIN_NAME=monienaija_admin
DB_RUNTIME_USER=monienaija_runtime
# Replace these with high-entropy synthetic values before execution on a shared host.
# The harness generates its own ephemeral passwords if these are left empty and passed
# via environment (see run-all.sh). The values below are placeholders only.
DB_ADMIN_PASSWORD=PortableAcceptance_Admin_PW_ChangeMe_001!
DB_RUNTIME_PASSWORD=PortableAcceptance_Runtime_PW_ChangeMe_002!
HTTP_PORT=18080
HTTPS_PORT=18443

# --- Runtime secrets (synthetic) --------------------------------------------
JWT_SECRET=portable-acceptance-jwt-secret-not-a-real-secret-32b-min!!
# Notification provider encryption: synthetic 32-byte key version v1
NOTIFICATION_PROVIDER_ENCRYPTION_KEYRING_JSON={"activeVersion":"v1","keys":{"v1":"cG9ydGFibGUtYWNjZXB0YW5jZS1mYWtlLWtleS0zMmIxISEhISE="}}
# Binding keyring (same synthetic key for portable run)
NOTIFICATION_PROVIDER_BINDING_KEYRING_JSON={"activeVersion":"v1","keys":{"v1":"cG9ydGFibGUtYWNjZXB0YW5jZS1mYWtlLWtleS0zMmIxISEhISE="}}

# --- Workers (enabled for acceptance) ---------------------------------------
PROCESS_ROLE=all-in-one
# For split-role acceptance, worker-acceptance.sh overrides with:
#   PROCESS_ROLE=worker  (worker)  and  PROCESS_ROLE=api (api replica)
BANKING_ENABLED=false
BANKING_ENVIRONMENT=sandbox
BANKING_INTAKE_DISABLED=false
BANKING_DISPATCH_WORKER_ENABLED=true
BANKING_DISPATCH_POLL_INTERVAL_MS=5000
BANKING_DISPATCH_LEASE_MS=30000
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_POLL_INTERVAL_MS=5000
CASH_TO_CASH_EXPIRY_WORKER_ENABLED=true
CASH_TO_CASH_EXPIRY_WORKER_POLL_INTERVAL_MS=60000
KYC_TIER_WORKER_ENABLED=true
KYC_TIER_WORKER_POLL_INTERVAL_MS=30000
NOTIFICATION_SMS_PROVIDER=console
NOTIFICATION_EMAIL_PROVIDER=console

# --- Alerting (synthetic local receiver) -----------------------------------
# The harness starts a local webhook receiver on the Docker host. The backend
# inside the data network reaches it via host.docker.internal:8765.
# Production alerting uses a real paging provider; this synthetic channel is
# acceptance-only and the release gate preserves the real-channel blocker.
ALERT_WEBHOOK_URL=http://host.docker.internal:8765/hooks/alerts
ALERT_WEBHOOK_SECRET=portable-acceptance-webhook-secret-32b-min!!
ALERT_WEBHOOK_TIMEOUT_MS=5000

# --- HTTP / proxy -----------------------------------------------------------
HTTP_CORS_ORIGINS_JSON=[]
HTTP_TRUST_PROXY=false
HTTP_BODY_LIMIT_BYTES=1048576
ADMIN_WEB_API_BASE_URL=/api/v1
WEBHOOK_ALLOWED_ORIGINS=

# --- Governance (disabled for portable run — financial blockers remain) ------
A2_WORKFORCE_ENABLED=false
A2_BOOTSTRAP_ENABLED=false
A2_FINANCE_ROLES_JSON=[]
A2_MAKER_CHECKER_RULES_JSON=[]
PROTECTED_AUTHORITY_DB_USER=
PROTECTED_AUTHORITY_DB_PASSWORD=

# --- Misc -------------------------------------------------------------------
IDEMPOTENCY_RETENTION_SECONDS=86400
OUTBOX_RETRY_DELAY_SECONDS=60
METRICS_RETENTION_SECONDS=2592000
AUDIT_RETENTION_SECONDS=31536000
OUTBOX_RETENTION_SECONDS=2592000
SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30
DB_SSL=false
DB_POOL_MAX=20
